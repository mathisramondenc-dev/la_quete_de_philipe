<?xml version="1.0" encoding="UTF-8"?>
<project name="DeLaTerreALAssiette-impl" default="default" basedir="..">
  <target name="default" depends="jar"/>
  <target name="jar" depends="compile">
    <mkdir dir="${dist.dir}"/><jar destfile="${dist.dir}/DeLaTerreALAssiette.jar" basedir="${build.classes.dir}"/>
  </target>
  <target name="compile">
    <mkdir dir="${build.classes.dir}"/><javac srcdir="${src.dir}" destdir="${build.classes.dir}" includeantruntime="false" source="8" target="8" encoding="UTF-8"/>
    <copy todir="${build.classes.dir}/resources" failonerror="false"><fileset dir="resources" erroronmissingdir="false"/></copy>
  </target>
  <property name="build.dir" value="build"/><property name="dist.dir" value="dist"/><property name="build.classes.dir" value="${build.dir}/classes"/><property name="src.dir" value="src"/>
</project>
